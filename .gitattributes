# Auto detect text files and perform LF normalization
* text=auto

# Source code and documentation (LF)
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Windows shell scripts (CRLF)
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary media files
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.avi binary
*.wmv binary
*.wav binary
*.ico binary
